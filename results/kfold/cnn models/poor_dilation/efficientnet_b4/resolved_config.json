{
  "winning_config": {
    "task": "poor_dilation",
    "model": "efficientnet_b4",
    "source_notebook": "Final_2_EfficientNet_B4.ipynb",
    "num_classes": 2,
    "pretrained": true,
    "input_resolution": 224,
    "batch_size": 64,
    "max_epochs": 30,
    "checkpoint_monitor": "validation_loss",
    "loss": {
      "name": "CrossEntropyLoss",
      "label_smoothing": 0.05,
      "class_weights": null
    },
    "fine_tuning": {
      "freeze_all_first": true,
      "unfreeze_scopes": [
        "features.7",
        "features.8",
        "classifier"
      ]
    },
    "optimizer": {
      "name": "AdamW",
      "parameter_groups": [
        {
          "name": "features_7",
          "scopes": [
            "features.7"
          ],
          "learning_rate": 5e-06,
          "weight_decay": 0.0001
        },
        {
          "name": "features_8",
          "scopes": [
            "features.8"
          ],
          "learning_rate": 5e-06,
          "weight_decay": 0.0001
        },
        {
          "name": "classifier",
          "scopes": [
            "classifier"
          ],
          "learning_rate": 8e-05,
          "weight_decay": 0.0001
        }
      ]
    },
    "scheduler": {
      "name": "ReduceLROnPlateau",
      "monitor": "validation_loss",
      "mode": "min",
      "factor": 0.5,
      "patience": 3,
      "min_learning_rate": 1e-06
    },
    "sampler": {
      "name": "BalancedClassSampler",
      "replacement": true,
      "target_per_class": {
        "0": 1000,
        "1": 1000
      },
      "samples_per_epoch": 2000,
      "all_sampled_training_images_receive_stochastic_augmentation": true
    },
    "augmentation": {
      "pad_to_square": "image_mean_rgb",
      "resize": 224,
      "rotation_degrees": 12,
      "horizontal_flip_probability": 0.3,
      "vertical_flip_probability": 0.0,
      "affine_translate": [
        0.1,
        0.1
      ],
      "affine_scale": [
        0.95,
        1.05
      ],
      "affine_shear": [
        -4,
        4
      ],
      "color_jitter": {
        "brightness": 0.25,
        "contrast": 0.25,
        "saturation": 0.1,
        "probability": 0.6
      },
      "gaussian_blur": {
        "kernel_size": 3,
        "sigma": [
          0.1,
          0.4
        ],
        "probability": 0.3
      },
      "normalize_mean": [
        0.485,
        0.456,
        0.406
      ],
      "normalize_std": [
        0.229,
        0.224,
        0.225
      ]
    },
    "reference_run": {
      "best_epoch_by_printed_validation_loss": 28,
      "best_validation_loss_rounded": 0.4577,
      "validation_accuracy_at_best_loss_rounded": 0.8419
    },
    "extraction_issues": [
      "Checkpoint filename is resnet18_poor_dilation_best.pth regardless of architecture; use a model-specific path in shared code.",
      "BalancedClassSampler uses NumPy randomness without an explicit notebook seed; seed it per fold for reproducibility."
    ]
  },
  "execution": {
    "n_splits": 5,
    "seed": 42,
    "batch_size_override": null
  }
}